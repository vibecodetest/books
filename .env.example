# Supabase Dashboard > Project Settings > Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Recommended server-only key from Settings > API Keys > Secret keys.
# It starts with sb_secret_. Never use sb_publishable_ here.
SUPABASE_SECRET_KEY=sb_secret_your-server-key

# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-jwt

# Google AI Studio에서 발급한 서버 전용 Gemini API 키입니다.
# 브라우저에 노출되는 NEXT_PUBLIC_ 접두사를 사용하지 마세요.
GEMINI_API_KEY=your-gemini-api-key

# 선택 사항: 기본값은 비용 효율적인 gemini-3.1-flash-lite-image 입니다.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
